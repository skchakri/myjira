<%# Labelled next-step buttons for the detail pane, by state. Merge and Deploy confirm in-page (details panel). %>
<% pr = context.pr_status %>
<% delivery = context.delivery %>
<% deployable = item.status == "done" && delivery&.state.in?(%w[not_live deploy_failed]) %>
<div class="wq-actions" role="group" aria-label="Next steps">
  <% if context.flow.stalled? %>
    <%= button_to "Resume", work_queue_item_resume_path(item.key), class: "wq-btn wq-btn-primary",
                  title: "No activity for a while: hand it back to its CLI session if that is listening, otherwise run it on the server",
                  form: { data: { turbo_stream: true } } %>
  <% end %>
  <% if item.awaiting_approval && item.open? %>
    <%= button_to "Approve & queue", work_queue_item_run_path(item.key), class: "wq-btn wq-btn-primary", form: { data: { turbo_stream: true } } %>
  <% elsif item.pending? %>
    <%= button_to "Run now", work_queue_item_run_path(item.key), class: "wq-btn wq-btn-primary", form: { data: { turbo_stream: true } } %>
  <% end %>

  <% if item.open? && (step = context.browser_step) %>
    <%= button_to work_queue_item_run_in_chrome_path(item.key), class: "wq-btn wq-btn-chrome",
                  title: step == :flag ? "Marked as a browser step" : "Looks like a browser step (auto-detected)",
                  form: { data: { turbo_stream: true } } do %>
      <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M12 8.5h8.2M8.9 13.8 4.8 6.7M15 13.8l-4.1 7.1"/></svg>
      Run in Chrome
    <% end %>
  <% end %>

  <% if item.ready_to_bundle? && item.pr.blank? %>
    <%= button_to "Ready for PR", work_queue_item_ship_path(item.key), class: "wq-btn wq-btn-primary",
                  title: "Bundle this task (and any ready follow-ups) into its parent's single PR now",
                  form: { data: { turbo_stream: true } } %>
  <% elsif item.pr.present? %>
    <a class="wq-btn" href="<%= item.pr %>" target="_blank" rel="noopener">Open PR<%= " ##{item.pr_number}" if item.pr_number %></a>
  <% elsif item.open? %>
    <button type="button" class="wq-btn" disabled title="Available once the task is built and tested">Ready for PR</button>
  <% end %>

  <% if context.chain_merge? %>
    <%= render "work_queue/merge", item: item, url: work_queue_item_merge_chain_path(item.key), context: context,
               label: "Merge (#{context.chain.map { |i| "##{i.n}" }.join(' → ')})" %>
  <% elsif context.card_merge? %>
    <%= render "work_queue/merge", item: item, url: work_queue_item_merge_pr_path(item.key), label: "Merge", context: context %>
  <% elsif item.open? %>
    <% why = if item.pr.blank? then "No PR yet"
             elsif context.dependencies.any? then "Waiting on #{context.dependencies.map { |d| "##{d.n}" }.join(', ')}"
             elsif pr && !pr.open? then "PR is #{pr.state.downcase}"
             else "Not ready to merge"
             end %>
    <button type="button" class="wq-btn" disabled title="<%= why %>">Merge</button>
  <% end %>

  <% if deployable %>
    <details class="wq-merge" data-work-queue-target="merge">
      <summary class="wq-btn wq-btn-merge">Deploy</summary>
      <%= form_with url: work_queue_item_deploy_path(item.key), data: { turbo_stream: true }, class: "wq-merge-panel" do %>
        <p class="text-[12px] font-medium">Run the repo's Deploy workflow on <code>main</code>?</p>
        <p class="wq-hint"><%= delivery.detail %> This deploys to production and cannot be undone from here.</p>
        <div class="flex gap-2 mt-2">
          <button type="submit" class="wq-btn wq-btn-primary">Confirm deploy</button>
          <button type="button" class="wq-btn wq-btn-ghost" data-action="work-queue#closeMerge">Cancel</button>
        </div>
      <% end %>
    </details>
  <% else %>
    <% why = if item.status != "done" then "Available after the PR is merged"
             elsif delivery.nil? then "No Deploy workflow found for this repo (or it is already live), so there is nothing to run from here"
             else delivery.detail
             end %>
    <button type="button" class="wq-btn" disabled title="<%= why %>">Deploy</button>
  <% end %>
</div>
<% if item.open? %>
  <% step = context.browser_step %>
  <div class="wq-browser-flag">
    <% if step %>
      <% if (blocker = context.chrome_blocker) %>
        <p class="wq-hint wq-chrome-blocked" role="status"><%= blocker %>
          <button type="button" class="wq-btn wq-btn-ghost" data-controller="wq-toast" data-action="wq-toast#copy"
                  data-text="/item<%= item.n %> <%= WorkQueue::Dispatcher::CHROME_COPY %>">Copy command</button></p>
      <% end %>
      <span class="wq-hint"><%= step == :flag ? "Marked as needing the browser." : "Auto-detected as a browser step." %></span>
      <%= button_to (step == :flag ? "Unmark" : "Not a browser step"), work_queue_item_browser_path(item.key),
                    params: { value: step == :flag ? "" : "0" }, class: "wq-btn wq-btn-ghost", form: { data: { turbo_stream: true } } %>
    <% else %>
      <%= button_to "Needs the browser", work_queue_item_browser_path(item.key), params: { value: "1" },
                    class: "wq-btn wq-btn-ghost", title: "Show a Run in Chrome button for this item",
                    form: { data: { turbo_stream: true } } %>
    <% end %>
  </div>
<% end %>
