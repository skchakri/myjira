<%# Open questions, first thing in the detail panel. One form, one "Send answers" button:
    answers[i] = picked option, custom[i] = free text (wins when filled). %>
<% open = item.questions.each_with_index.reject { |q, _| q.a } %>
<% if open.any? %>
  <section class="wq-qbox" aria-labelledby="wq_qbox_h" data-work-queue-target="question" data-item-key="<%= item.key %>"
           data-action="input->work-queue#saveDraft change->work-queue#saveDraft change->work-queue#chipPicked turbo:submit-end->work-queue#clearDraft">
    <h3 id="wq_qbox_h" class="wq-qbox-h"><%= open.size == 1 ? "1 question for you" : "#{open.size} questions for you" %></h3>
    <%= form_with url: work_queue_item_answer_path(item.key), data: { turbo_stream: true }, class: "wq-qbox-form" do %>
      <%# Several permission prompts stacked up: one click answers them all. %>
      <% perms = open.select { |q, _| WorkQueue::PermissionRules.permission_question?(q.q) && q.options.include?("Allow once") } %>
      <% if perms.size > 1 %>
        <div class="wq-allow-all" role="group" aria-label="Answer every permission prompt at once">
          <span class="wq-allow-all-t"><%= perms.size %> of these are permission prompts.</span>
          <% if perms.all? { |q, _| WorkQueue::PermissionRules.safe_question?(q.q) } %>
            <button type="submit" name="allow_all" value="always" class="wq-btn wq-btn-primary" data-allow-all title="Read, test and lint commands only (a)">Always allow all <%= perms.size %> in this project <kbd>a</kbd></button>
            <button type="submit" name="allow_all" value="once" class="wq-btn">Allow all <%= perms.size %> once</button>
          <% else %>
            <button type="submit" name="allow_all" value="once" class="wq-btn wq-btn-primary" data-allow-all title="Allow each of them for this run (a)">Allow all <%= perms.size %> <kbd>a</kbd></button>
          <% end %>
        </div>
      <% end %>
      <% open.each do |q, idx| %>
        <fieldset class="wq-question">
          <legend class="wq-q-text"><%= q.q %></legend>
          <% if q.options.any? %>
            <div class="wq-chips">
              <% q.options.first(4).each_with_index do |opt, k| %>
                <label class="wq-chip <%= 'wq-chip-rec' if k.zero? %>">
                  <input type="radio" class="wq-chip-input" id="wq_answer_<%= item.key.parameterize %>_<%= idx %>_<%= k %>" name="answers[<%= idx %>]" value="<%= opt %>" data-option="<%= k + 1 %>">
                  <kbd><%= k + 1 %></kbd> <span><%= opt %><%= " (suggested)" if k.zero? %></span>
                </label>
              <% end %>
            </div>
          <% else %>
            <% answers = WorkQueue::Suggestions.fetch_or_request(item, idx, q.q) %>
            <%= render "work_queue/suggestions", item: item, index: idx, question: q.q, answers: answers,
                                                 pending: answers.nil? && WorkQueue::RunState.runner.present? %>
          <% end %>
          <div class="wq-free">
            <%= text_area_tag "custom[#{idx}]", nil, id: "wq_custom_#{item.key.parameterize}_#{idx}", rows: 2, placeholder: "Or write your own answer…", class: "wq-input",
                              "aria-label": "Or write your own answer", data: { work_queue_target: "answer" } %>
            <button type="button" class="wq-mic" aria-label="Answer by voice" data-action="work-queue#dictate">mic</button>
          </div>
        </fieldset>
      <% end %>
      <div class="wq-send-bar">
        <button type="submit" class="wq-btn wq-btn-primary">Send answers</button>
        <%# Picking a chip only selects it; say so until the form is sent (a single question sends on pick). %>
        <span class="wq-send-status" data-send-status role="status" aria-live="polite" hidden></span>
      </div>
    <% end %>
  </section>
<% end %>
