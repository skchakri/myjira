<% content_for :title, "Work Queue settings · myjira" %>
<div class="max-w-3xl">
  <h1 class="text-xl font-semibold">Work Queue settings</h1>
  <p class="text-sm mt-1" style="color: var(--color-ink-soft)">The routing table is the fallback and guardrail for the router (claude-haiku-5-5, low effort). A failed test leg or retry escalates to a stronger model. You can override the model per item, or lock it, from the item's log header.</p>
  <%= form_with url: work_queue_settings_path, method: :patch, class: "mt-6 space-y-6" do %>
    <table class="wq-table">
      <thead><tr><th>Phase</th><th>Model</th><th>Effort</th></tr></thead>
      <tbody>
        <% WorkQueue::Router::PHASES.each do |ph| %>
          <tr>
            <td><%= ph %></td>
            <td><select name="routing[<%= ph %>][model]" class="wq-input"><% WorkQueue::Router::MODELS.each do |m| %><option <%= "selected" if @routing.dig(ph, "model") == m %>><%= m %></option><% end %></select></td>
            <td><select name="routing[<%= ph %>][effort]" class="wq-input"><% WorkQueue::Router::EFFORTS.each do |e| %><option <%= "selected" if @routing.dig(ph, "effort") == e %>><%= e %></option><% end %></select></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <button class="wq-btn wq-btn-primary">Save</button> <%= link_to "Back to queue", work_queue_path, class: "wq-link" %>
    <%= link_to "Costs", work_queue_costs_path, class: "wq-link" %>
  <% end %>

  <section class="mt-10" aria-labelledby="wq-ladder-h">
    <h2 id="wq-ladder-h" class="text-lg font-semibold">What a retry costs</h2>
    <p class="wq-hint mt-1">The table above is the ceiling for a first attempt: the router may pick something cheaper, never a stronger model. Each failed attempt moves one step: a stronger model first, then one more effort level, never past <%= WorkQueue::Router::EFFORT_CEILING %>. Only your own override or the table can use max.</p>
    <table class="wq-table">
      <thead><tr><th>Phase</th><th>First attempt (at most)</th><th>After 1 failure</th><th>After 2 failures</th></tr></thead>
      <tbody>
        <% WorkQueue::Router::PHASES.each do |ph| %>
          <tr>
            <td><%= ph %></td>
            <% WorkQueue::Router.ladder(@routing.dig(ph, "model"), @routing.dig(ph, "effort")).each do |model, effort| %>
              <td class="wq-mono"><%= model.delete_prefix("claude-") %> · <%= effort %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <section class="mt-10" aria-labelledby="wq-rules-h">
    <h2 id="wq-rules-h" class="text-lg font-semibold">Always-allowed tools</h2>
    <p class="wq-hint mt-1">Claude Code allowedTools rules the server runner passes for this project, e.g. <code>Bash(bin/rails test:*)</code>, <code>Bash(git push:*)</code>, <code>WebFetch</code>. Edits are auto-accepted (acceptEdits); anything else is denied and shown as Allow once / Always allow / Deny chips. A command you allow once twice becomes a rule here by itself.</p>
    <%= form_with url: work_queue_settings_path, method: :get, class: "mt-3 flex items-center gap-2", data: { controller: "auto-submit" } do %>
      <label class="wq-label" for="rules-slug">Project</label>
      <select id="rules-slug" name="slug" class="wq-input" data-action="change->auto-submit#submit">
        <option value="">Pick a project…</option>
        <% @projects.each do |label, slug, _| %><option value="<%= slug %>" <%= "selected" if slug == @slug %>><%= label %></option><% end %>
      </select>
      <noscript><button class="wq-btn wq-btn-ghost">Open</button></noscript>
    <% end %>
    <% if @slug %>
      <%= form_with url: work_queue_settings_path, method: :patch, class: "mt-4" do %>
        <%= hidden_field_tag :slug, @slug %>
        <%= hidden_field_tag "rules[]", "", id: nil %>
        <%= hidden_field_tag :packs_shown, "1" %>
        <fieldset class="wq-packs">
          <legend class="wq-label">Default allow packs</legend>
          <p class="wq-hint">Commands in a pack run without asking, including wrapped forms such as <code>PATH=… rvm 3.3.6 do bundle exec rspec</code>. Stack packs apply when the repo has the marker file.</p>
          <% WorkQueue::PermissionRules::PACKS.each do |name, pack| %>
            <% detected = @packs_detected.include?(name) %>
            <label class="wq-pack <%= 'wq-pack-off' unless detected %>">
              <%= check_box_tag "packs[]", name, @packs_off.exclude?(name), id: "pack-#{name}" %>
              <span>
                <strong><%= pack[:label] %></strong>
                <% if pack[:marker] %><span class="wq-hint"><%= detected ? "#{pack[:marker]} found" : "no #{pack[:marker]} in this repo, not applied" %></span><% end %>
                <span class="wq-pack-cmds wq-mono"><%= pack[:prefixes].join(" · ") %></span>
              </span>
            </label>
          <% end %>
        </fieldset>
        <h3 class="wq-label mt-4">Your rules</h3>
        <% if @rules.empty? %><p class="wq-hint">No rules yet for this project.</p><% end %>
        <% @rules.each_with_index do |rule, i| %>
          <div class="wq-rule-row">
            <%= text_field_tag "rules[]", rule, id: "rule-#{i}", class: "wq-input wq-mono flex-1", "aria-label": "Rule #{i + 1}" %>
            <label class="wq-toggle"><%= check_box_tag "delete_rules[]", rule, false, id: "del-#{i}" %> delete</label>
          </div>
        <% end %>
        <label class="wq-label mt-4 block" for="new_rules">Add rules (one per line)</label>
        <textarea id="new_rules" name="new_rules" rows="3" class="wq-input mt-1 w-full wq-mono" placeholder="Bash(bundle exec rspec:*)"></textarea>
        <button class="wq-btn wq-btn-primary mt-2">Save rules</button>
      <% end %>
    <% end %>
  </section>

  <section class="mt-10" aria-labelledby="wq-budget-h">
    <h2 id="wq-budget-h" class="text-lg font-semibold">Daily budget</h2>
    <p class="wq-hint mt-1">Optional, per project. Once the server runner has spent this much on a project today, new tasks for it wait as queued until tomorrow. Run now on a task overrides it; tasks already running finish their phase. Leave blank for no budget.</p>
    <% if @slug %>
      <%= form_with url: work_queue_settings_path, method: :patch, class: "mt-3 flex flex-wrap items-center gap-2" do %>
        <%= hidden_field_tag :slug, @slug %>
        <label class="wq-label" for="daily_budget">Budget for <%= WorkQueue::Store.label(@slug) %> ($ per day)</label>
        <%= number_field_tag :daily_budget, (@budget && format("%.2f", @budget)), min: 0, step: 0.5, class: "wq-input wq-mono", style: "width: 8rem", placeholder: "none" %>
        <button class="wq-btn wq-btn-primary">Save budget</button>
        <span class="wq-hint">Spent today: <%= wq_money(WorkQueue::Costs.today(@slug)) %></span>
      <% end %>
    <% else %>
      <p class="wq-hint mt-2">Pick a project above to set its budget.</p>
    <% end %>
  </section>
</div>
