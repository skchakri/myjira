<%# "Run in Chrome" control. Idle → the button (plus "Launch failed: …" when the last launch failed). A launch in flight → "Starting Claude…",
    then a link to the session's live terminal, so a click is visibly acknowledged and
    can't queue a duplicate. Replaced in place by the click's turbo stream and by
    WorkQueue::ChromeRun.launch_changed when the daemon reports the launch. %>
<% launch = context.chrome_launch %>
<span id="<%= WorkQueue::ChromeRun.dom_id(item) %>" class="wq-chrome-run">
  <% if launch&.live_terminal_url.present? %>
    <a class="wq-btn wq-chrome-status wq-chrome-live" href="<%= launch.live_terminal_url %>" target="_blank" rel="noopener"
       title="Claude is working this item in Chrome: open its live terminal">
      <span class="wq-live-dot" aria-hidden="true"></span> Running in Chrome · Watch ↗
    </a>
  <% elsif launch %>
    <span class="wq-btn wq-chrome-status" role="status"
          title="The session launcher is starting a Claude session with Chrome for this item">
      <span class="wq-live-dot" aria-hidden="true"></span> Starting Claude…
    </span>
  <% elsif item.open? && (step = context.browser_step) %>
    <%= button_to work_queue_item_run_in_chrome_path(item.key), class: "wq-btn wq-btn-chrome",
                  title: step == :flag ? "Marked as a browser step" : "Looks like a browser step (auto-detected)",
                  form: { data: { turbo_stream: true } } do %>
      <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M12 8.5h8.2M8.9 13.8 4.8 6.7M15 13.8l-4.1 7.1"/></svg>
      Run in Chrome
    <% end %>
    <% if (failed = context.chrome_failure) %>
      <span class="wq-hint wq-chrome-failed" role="status" title="<%= failed.error.to_s.squish.truncate(500) %>">Launch failed: <%= WorkQueue::ChromeRun.failure_reason(failed) %></span>
    <% end %>
    <% if (sent = context.chrome_sent_at) %>
      <span class="wq-hint" role="status">Sent to the CLI session at <%= sent.strftime("%H:%M") %></span>
    <% end %>
  <% end %>
</span>
