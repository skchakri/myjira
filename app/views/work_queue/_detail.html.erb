<%= turbo_stream_from WorkQueue::Broadcaster.item_stream(item.key) %>
<% if context.server_run? %>
  <%= turbo_stream_from WorkQueue::Broadcaster.run_stream(item.key) %>
<% elsif item.agent.present? %>
  <%= turbo_stream_from WorkQueue::Broadcaster.log_stream(item.agent) %>
<% end %>
<div class="wq-detail-grid" data-key="<%= item.key %>">
  <section class="wq-main">
    <%= render "work_queue/log_header", item: item, context: context %>
    <div class="wq-log" data-work-queue-target="log" data-action="scroll->work-queue#logScrolled">
      <% if context.transcript_path.nil? && !context.server_run? %>
        <p class="wq-empty">No agent transcript yet<%= " (agent #{item.agent})" if item.agent %>. The log streams in once an agent starts.</p>
      <% end %>
      <ol id="wq_log_entries" class="wq-entries">
        <% item.log.each do |l| %>
          <li class="wq-entry wq-k-queue"><span class="wq-time"><%= Time.zone.at(l["at"].to_i / 1000).strftime("%H:%M") %></span> <%= l["text"] %></li>
        <% end %>
        <% entries.each do |e| %>
          <%= render "work_queue/entry", entry: e, results: entries %>
        <% end %>
      </ol>
      <button type="button" class="wq-jump hidden" data-work-queue-target="jump" data-action="work-queue#jumpToEnd">Jump to latest</button>
    </div>
  </section>
  <%= render "work_queue/side", item: item %>
</div>
