<%= turbo_stream_from WorkQueue::Broadcaster.item_stream(item.key) %>
<% if context.server_run? %>
  <%= turbo_stream_from WorkQueue::Broadcaster.run_stream(item.key) %>
<% elsif (agent = WorkQueue::Transcript.stream_id(context.transcript_path)) %>
  <%= turbo_stream_from WorkQueue::Broadcaster.log_stream(agent) %>
<% end %>
<section class="wq-main wq-detail-grid" data-key="<%= item.key %>" data-slug="<%= item.slug %>">
  <%= render "work_queue/log_header", item: item, context: context %>
  <h3 class="wq-eyebrow wq-log-label">Live log</h3>
  <div class="wq-log" data-work-queue-target="log" data-action="scroll->work-queue#logScrolled">
    <% if context.transcript_path.nil? && !context.server_run? %>
      <p class="wq-empty" role="status"><%= WorkQueue::Transcript.missing_reason(item) %></p>
    <% end %>
    <ol id="wq_log_entries" class="wq-entries">
      <% label = "##{item.n}" %>
      <% entries.each do |e| %>
        <%= render "work_queue/entry", entry: e, results: entries, slug: item.slug, label: label %>
      <% end %>
    </ol>
    <button type="button" class="wq-jump hidden" data-work-queue-target="jump" data-action="work-queue#jumpToEnd">Jump to latest</button>
  </div>
  <%= form_with url: work_queue_item_instruct_path(item.key), multipart: true, class: "wq-instruct",
                data: { turbo_stream: true, wq_drop: true, action: "turbo:submit-end->work-queue#resetForm dragover->work-queue#dragOver dragleave->work-queue#dragLeave drop->work-queue#drop paste->work-queue#paste" } do %>
    <input type="file" name="files[]" multiple accept="image/*,application/pdf,text/*,.md,.json,.log" class="hidden" data-action="change->work-queue#filesPicked">
    <p class="wq-files wq-files-row" data-wq-files></p>
    <span class="wq-n">task <%= item.n %></span>
    <span class="wq-ref-chips" data-work-queue-target="refChips"></span>
    <%= text_area_tag :text, nil, rows: 1, placeholder: "Tell the agent on this task what to do… (Enter to send; drop or paste files)", class: "wq-input wq-instruct-input", "aria-label": "Instruction", data: { work_queue_target: "instruct", action: "input->work-queue#scanRefs keydown->work-queue#instructKey" } %>
    <button type="button" class="wq-mic" aria-label="Speak instruction" data-action="work-queue#dictate">mic</button>
    <button type="button" class="wq-mic" aria-label="Attach files" title="Attach files (or drop / paste them here)" data-action="work-queue#pickFiles">file</button>
    <button class="wq-btn wq-btn-primary">Send</button>
  <% end %>
</section>
