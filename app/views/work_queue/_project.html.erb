<%# One project in the Flow tree: collapsible header with badges, then tasks with follow-ups nested under their parent. %>
<% selected = local_assigns[:selected] %>
<% store = WorkQueue::Store.new %>
<% contexts = items.to_h { |i| [i.key, WorkQueue::ItemContext.wanted?(i) ? WorkQueue::ItemContext.new(i, store: store) : nil] } %>
<% flows = items.to_h { |i| [i.key, contexts[i.key]&.flow || WorkQueue::Flow.new(i)] } %>
<% ns = items.to_set(&:n) %>
<% order = WorkQueue::Store::DISPLAY_ORDER %>
<% progress = WorkQueue::Progress.new(items, flows: flows, store: store) %>
<%# A finished task whose child steps are still open stays up with the open work. %>
<% sorted = items.sort_by { |i| [i.open? || progress.for(i).active ? 0 : 1, order.index(i.display_status) || 9, -i.n] } %>
<% children = sorted.group_by { |i| i.parent && i.parent != i.n && ns.include?(i.parent) ? i.parent : nil } %>
<% live = flows.values.reject(&:closed?) %>
<% need = live.count { |f| f.tags.include?("you") } %>
<% failed = live.count { |f| f.tone == "bad" } %>
<% open_n = items.count(&:open?) %>
<% done_n = flows.values.count(&:finished?) %>
<section id="wq_project_<%= slug %>" class="wq-project" data-slug="<%= slug %>" data-work-queue-target="project">
  <div class="wq-proj-bar">
  <button type="button" class="wq-proj" aria-expanded="true" aria-controls="wq_tree_<%= slug %>" data-action="work-queue#toggleProject">
    <svg class="wq-car" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
    <svg class="wq-folder" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M1.5 3.5h5l1.5 1.5h6.5v8h-13z" stroke="currentColor" stroke-width="1.3" fill="none"/></svg>
    <span class="wq-proj-name">
      <span class="wq-proj-title truncate" title="<%= slug %>"><%= WorkQueue::Store.label(slug) %></span>
      <span class="wq-proj-sub"><%= open_n %> open · <%= done_n %> done</span>
    </span>
    <span class="wq-proj-cnt">
      <% if need.positive? %><span class="wq-pbadge wq-pb-you"><%= need %> need you</span><% end %>
      <% if failed.positive? %><span class="wq-pbadge wq-pb-bad"><%= failed %> failed</span><% end %>
      <span class="wq-pbadge wq-pb-n" title="Tasks not merged or dropped"><%= live.size %></span>
    </span>
  </button>
  <button type="button" class="wq-proj-add" title="Add a task to <%= WorkQueue::Store.label(slug) %>" aria-label="Add a task to <%= WorkQueue::Store.label(slug) %>"
          data-slug="<%= slug %>" data-label="<%= WorkQueue::Store.label(slug) %>" data-action="work-queue#addToProject">
    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span class="wq-proj-add-t">Add</span>
  </button>
  </div>
  <div id="wq_tree_<%= slug %>" class="wq-tree">
    <%= render "work_queue/tree", nodes: children[nil] || [], children: children, contexts: contexts, flows: flows,
                                  selected: selected, depth: 0, seen: (seen = Set.new), progress: progress %>
    <%# Parent cycles never reach a root; show those items flat so nothing disappears. %>
    <%= render "work_queue/tree", nodes: sorted.reject { |i| seen.include?(i.n) }, children: {}, contexts: contexts, flows: flows,
                                  selected: selected, depth: 0, seen: seen, progress: progress %>
  </div>
</section>
