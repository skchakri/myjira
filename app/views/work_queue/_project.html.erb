<%# One project in the Flow tree: collapsible header with badges, then tasks with follow-ups nested under their parent.
    Draws only the work still going plus a few recent finished tasks (WorkQueue::Listing); "Show N older" loads the rest. %>
<% listing = local_assigns[:listing] || WorkQueue::Listing.new(slug, items, selected: local_assigns[:selected], all: local_assigns[:all]) %>
<% selected = local_assigns[:selected] %>
<% label = WorkQueue::Store.label(slug) %>
<% older = listing.older_count %>
<section id="wq_project_<%= slug %>" class="wq-project" data-slug="<%= slug %>" data-work-queue-target="project"
         data-older="<%= older %>" data-all="<%= listing.all? ? 'true' : 'false' %>" data-older-url="<%= work_queue_project_path(slug) %>">
  <div class="wq-proj-bar">
  <button type="button" class="wq-proj" aria-expanded="true" aria-controls="wq_tree_<%= slug %>" data-action="work-queue#toggleProject">
    <svg class="wq-car" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
    <svg class="wq-folder" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M1.5 3.5h5l1.5 1.5h6.5v8h-13z" stroke="currentColor" stroke-width="1.3" fill="none"/></svg>
    <span class="wq-proj-name">
      <span class="wq-proj-title truncate" title="<%= slug %>"><%= label %></span>
      <%= render "work_queue/project_sub", listing: listing %>
    </span>
    <%= render "work_queue/project_counts", listing: listing %>
  </button>
  <button type="button" class="wq-proj-add" title="Add a task to <%= label %>" aria-label="Add a task to <%= label %>"
          data-slug="<%= slug %>" data-label="<%= label %>" data-action="work-queue#addToProject">
    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span class="wq-proj-add-t">Add</span>
  </button>
  </div>
  <div id="wq_tree_<%= slug %>" class="wq-tree">
    <%= render "work_queue/tree", nodes: listing.children[nil] || [], children: listing.children, contexts: listing.contexts, flows: listing.flows,
                                  selected: selected, depth: 0, seen: (seen = Set.new), progress: listing.progress %>
    <%# Parent cycles never reach a root; show those items flat so nothing disappears. %>
    <%= render "work_queue/tree", nodes: listing.visible.reject { |i| seen.include?(i.n) }, children: {}, contexts: listing.contexts, flows: listing.flows,
                                  selected: selected, depth: 0, seen: seen, progress: listing.progress %>
    <% if older.positive? %>
      <% if listing.all? %>
        <button type="button" class="wq-older" data-action="work-queue#hideOlder">Hide <%= older %> older finished <%= 'task'.pluralize(older) %></button>
      <% else %>
        <button type="button" class="wq-older" data-action="work-queue#showOlder"
                title="Finished tasks that are not part of any open work">Show <%= older %> older finished <%= 'task'.pluralize(older) %></button>
      <% end %>
    <% end %>
  </div>
</section>
