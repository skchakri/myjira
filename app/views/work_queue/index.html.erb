<% content_for :title, "Work Queue · myjira" %>
<% content_for :sidebar_default, "collapsed" %>
<% content_for :full_bleed, "1" %>
<%= turbo_stream_from WorkQueue::Broadcaster::LIST_STREAM %>
<div class="wq" data-controller="work-queue"
     data-work-queue-selected-value="<%= @item&.key %>"
     data-work-queue-group-url-value="<%= work_queue_group_path %>">
  <header class="wq-top">
    <div class="flex items-center gap-3 min-w-0">
      <h1 class="text-[15px] font-semibold tracking-tight">Work Queue</h1>
      <span class="wq-live" title="Push updates over Action Cable"><span class="wq-live-dot"></span>live</span>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" class="wq-btn wq-btn-ghost hidden" data-work-queue-target="groupBtn" data-action="work-queue#group">
        Group / merge <span data-work-queue-target="groupCount"></span>
      </button>
      <label class="wq-toggle" title="Speak when an item needs you or is ready for review">
        <input type="checkbox" data-work-queue-target="speakToggle" data-action="work-queue#toggleSpeak"> Announce
      </label>
      <button type="button" class="wq-btn wq-btn-ghost" data-action="work-queue#enableNotifications" data-work-queue-target="notifyBtn">Notify me</button>
      <%= link_to "Routing", work_queue_settings_path, class: "wq-btn wq-btn-ghost" %>
      <button type="button" class="wq-btn wq-btn-ghost" data-action="work-queue#toggleHelp" aria-label="Keyboard shortcuts">?</button>
    </div>
  </header>

  <div class="wq-help hidden" data-work-queue-target="help">
    <kbd>j</kbd>/<kbd>k</kbd> move · <kbd>Enter</kbd> open · <kbd>x</kbd> select · <kbd>g</kbd> group · <kbd>r</kbd> run now ·
    <kbd>1</kbd>-<kbd>4</kbd> pick option · <kbd>m</kbd> merge · <kbd>v</kbd> voice · <kbd>/</kbd> answer box · <kbd>n</kbd> new item · <kbd>s</kbd> stop · <kbd>Esc</kbd> close
  </div>

  <div class="wq-grid" data-work-queue-target="grid">
    <div class="wq-resizer" role="separator" aria-orientation="vertical" aria-label="Resize task list" title="Drag to resize · double-click to reset"
         data-action="pointerdown->work-queue#startResize dblclick->work-queue#resetResize"></div>
    <nav class="wq-list" aria-label="Projects and tasks">
      <%= render "work_queue/composer" %>
      <div class="wq-filter">
        <input type="search" class="wq-input" placeholder="Search tasks…" aria-label="Search tasks" data-work-queue-target="search" data-action="input->work-queue#filter">
        <select class="wq-input wq-input-sm" aria-label="Project filter" data-work-queue-target="projectFilter" data-action="change->work-queue#filter">
          <option value="">All projects</option>
          <% @projects.each_key do |slug| %><option value="<%= slug %>"><%= WorkQueue::Store.label(slug) %></option><% end %>
        </select>
      </div>
      <div class="wq-chipbar" role="group" aria-label="Show">
        <% WorkQueue::Flow::FILTERS.each do |key, label| %>
          <button type="button" class="wq-tab" aria-pressed="<%= key == 'all' %>" data-f="<%= key %>"
                  data-work-queue-target="tab" data-action="work-queue#pickFilter"><%= label %> <span class="wq-tab-n" data-count></span></button>
        <% end %>
      </div>
      <div class="wq-legend" aria-hidden="true">
        <span><i class="wq-dot wq-t-you"></i>needs you</span><span><i class="wq-dot wq-t-run"></i>in progress</span>
        <span><i class="wq-dot wq-t-bad"></i>failed</span><span><i class="wq-dot wq-t-ok"></i>live</span><span><i class="wq-dot wq-t-wait"></i>queued</span>
      </div>
      <div class="wq-bulk" role="group" aria-label="Projects">
        <button type="button" data-action="work-queue#expandAll">Expand all</button>
        <button type="button" data-action="work-queue#collapseAll">Collapse all</button>
      </div>
      <% if @projects.empty? %>
        <p class="wq-empty">No queue files in <code><%= WorkQueue::Store.dir %></code> yet.</p>
      <% end %>
      <% @projects.each do |slug, items| %>
        <%= render "work_queue/project", slug: slug, items: items, selected: @item&.key %>
      <% end %>
    </nav>

    <%= turbo_frame_tag "wq_detail", class: "wq-detail", src: (work_queue_item_detail_path(@item.key) if @item),
                                     data: { work_queue_target: "frame", action: "turbo:before-fetch-request->work-queue#frameLoading" } do %>
      <% if @item %>
        <div class="wq-placeholder"><p class="text-[13px]">Loading task <%= @item.n %>…</p></div>
      <% else %>
        <div class="wq-placeholder">
          <p class="text-[13px]">Pick a task to see what is happening and what it needs from you.</p>
          <p class="text-[12px] mt-1 opacity-70">Press <kbd>j</kbd> / <kbd>k</kbd> then <kbd>Enter</kbd>.</p>
        </div>
      <% end %>
    <% end %>
  </div>

  <div id="wq_events" class="hidden" data-work-queue-target="events"></div>
  <div class="wq-confirm hidden" data-work-queue-target="confirm" role="alertdialog" aria-live="assertive">
    <span data-work-queue-target="confirmText"></span>
    <button type="button" class="wq-btn wq-btn-primary" data-action="work-queue#confirmMerge">Merge</button>
    <button type="button" class="wq-btn wq-btn-ghost" data-action="work-queue#cancelMerge">Cancel</button>
  </div>
  <div id="wq_toasts" class="wq-toasts" aria-live="polite"></div>
</div>
