<%# Open questions as a popover anchored to the card (no permanent column). %>
<% open = item.questions.each_with_index.reject { |q, _| q.a } %>
<% if open.any? %>
  <details class="wq-pop" data-work-queue-target="question" data-action="mouseenter->work-queue#peek mouseleave->work-queue#unpeek">
    <summary class="wq-qbtn"><%= pluralize(open.size, "question") %></summary>
    <div class="wq-pop-card" role="dialog" aria-label="Questions for #<%= item.n %>">
      <% open.each do |q, idx| %>
        <div class="wq-q">
          <p class="wq-q-text"><%= q.q %></p>
          <% if q.options.any? %>
            <div class="wq-chips">
              <% q.options.first(4).each_with_index do |opt, k| %>
                <%= button_to work_queue_item_answer_path(item.key), params: { index: idx, text: opt },
                      class: "wq-chip", form: { data: { turbo_stream: true } }, data: { option: k + 1 } do %>
                  <kbd><%= k + 1 %></kbd> <%= opt %>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <% answers = WorkQueue::Suggestions.fetch_or_request(item, idx, q.q) %>
            <%= render "work_queue/suggestions", item: item, index: idx, question: q.q, answers: answers,
                                                 pending: answers.nil? && WorkQueue::RunState.runner.present? %>
          <% end %>
          <%= form_with url: work_queue_item_answer_path(item.key), data: { turbo_stream: true }, class: "wq-free" do %>
            <%= hidden_field_tag :index, idx %>
            <%= text_field_tag :text, nil, placeholder: "Or type an answer…", class: "wq-input", "aria-label": "Answer", data: { work_queue_target: "answer" } %>
            <button type="button" class="wq-mic" aria-label="Answer by voice" data-action="work-queue#dictate">mic</button>
          <% end %>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
