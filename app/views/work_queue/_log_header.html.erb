<%# Top of the detail panel. Replaced live via the item stream (target wq_log_header). %>
<% context ||= WorkQueue::ItemContext.new(item, store: WorkQueue::Store.new) %>
<% flow = context.flow %>
<% progress = context.progress %>
<% roll = context.roll %>
<header id="wq_log_header" class="wq-log-h wq-flow">
  <nav class="wq-crumbs" aria-label="Breadcrumb">
    <span><%= WorkQueue::Store.label(item.slug) %></span>
    <% context.ancestors.each do |a| %>
      <span aria-hidden="true">›</span>
      <%= link_to a.title.truncate(40), work_queue_item_detail_path(a.key), class: "wq-crumb-link", data: { turbo_frame: "wq_detail" } %>
    <% end %>
    <span aria-hidden="true">›</span><span aria-current="page">this task</span>
  </nav>

  <div class="wq-flow-head">
    <div class="flex flex-wrap items-center gap-2">
      <span class="wq-pill wq-pill-<%= flow.tone %>"><%= flow.label %></span>
      <%= wq_wait_tag(flow, prefix: item.errand? ? "yours for " : "waiting ") unless flow.stalled? %>
      <% if roll.left.positive? && (flow.finished? || flow.closed?) %>
        <span class="wq-pill wq-pill-run"><%= pluralize(roll.left, "child step") %> still in progress</span>
      <% end %>
      <span class="wq-hint wq-mono"><%= flow.ref %></span>
      <% if item.session.present? %><%= render "work_queue/listener", item: item %><% end %>
      <span class="ml-auto"><%= wq_copy_menu(item, context) %></span>
    </div>
    <h2 class="wq-flow-title"><%= item.title %></h2>
  </div>

  <%= render "work_queue/question_box", item: item %>
  <% merge_on_top = item.status == "review" && (context.card_merge? || context.chain_merge?) %>
  <%= render "work_queue/merge_top", item: item, context: context if merge_on_top %>
  <%= render "work_queue/steps", item: item, context: context if item.steps? %>

  <section class="wq-box wq-now" aria-label="What's happening">
    <span class="wq-eyebrow">What's happening</span>
    <% if roll.percent %>
      <div class="wq-overall">
        <%= wq_progress(roll.percent, tone: wq_progress_tone(flow, roll), css: "wq-prog-lg",
                        label: roll.parent? ? "This task with its child steps" : "This task") %>
        <span class="wq-hint">
          <% if roll.parent? %>
            <%= "This task #{roll.own}% · " if roll.own %>child steps <%= roll.done %> of <%= roll.total %> done
          <% elsif item.steps? && !flow.finished? %>
            plan <%= item.steps_done %> of <%= pluralize(item.plan_steps.size, "step") %> done
          <% elsif item.yours? %>
            <%= roll.complete? ? "done by you" : "yours to do: no agent phases" %>
          <% else %>
            <%= roll.complete? ? "all six phases done" : "phase #{[flow.phase + 1, 6].min} of 6" %>
          <% end %>
        </span>
      </div>
    <% end %>
    <% if item.yours? %>
      <%# An errand has no agent phases: one box to tick. %>
      <div class="wq-errand-row <%= 'wq-errand-row-done' unless item.open? %>">
        <% if item.open? %>
          <%= button_to work_queue_item_errand_path(item.key), params: { op: "done" }, class: "wq-errand-done", form: { data: { turbo_stream: true } } do %>
            <span class="wq-errand-box" aria-hidden="true"></span>Tick off when you have done it
          <% end %>
          <span class="wq-hint">
            <%= item.snoozed? ? "Snoozed until #{item.snoozed_until.strftime('%a %b %-d')}." : (item.due ? "Due #{item.due.strftime('%a %b %-d')}." : "No due date.") %>
            This one is yours: no agent will run it.
          </span>
        <% else %>
          <span class="wq-errand-box wq-errand-box-on" aria-hidden="true"></span><span>Done by you</span>
        <% end %>
      </div>
    <% else %>
      <% now = WorkQueue::Flow::PHASES[flow.phase] %>
      <ol class="wq-path" aria-label="<%= now ? "Now: #{now}" : 'All phases done' %>">
        <% flow.phases.each_with_index do |(name, state), i| %>
          <%= tag.li class: ["wq-step", ("wq-step-#{state}" if state)], aria: { current: ("step" if i == flow.phase) } do %><i aria-hidden="true"></i><%= name %><% end %>
        <% end %>
      </ol>
    <% end %>
    <% if WorkQueue::Errands.suggest?(item, run: context.run) %>
      <%= render "work_queue/errand_hint", item: item %>
    <% end %>
    <% if flow.failed_checks.any? %>
      <p class="text-[12.5px]"><strong>Failed checks:</strong> <%= flow.failed_checks.join(", ") %></p>
    <% end %>
    <% if flow.delivery_note %>
      <p class="text-[12.5px]"><%= flow.delivery_note %>
        <% if flow.delivery_url %><a class="wq-link" href="<%= flow.delivery_url %>" target="_blank" rel="noopener">Open the run</a><% end %></p>
    <% end %>
    <%= render "work_queue/cleanup", item: item %>
    <% if roll.left.positive? && (flow.finished? || flow.closed?) %>
      <p class="text-[12.5px] wq-kid-note">This task itself is finished, but <%= pluralize(roll.left, "child step") %> below <%= roll.left == 1 ? "is" : "are" %> not.</p>
    <% end %>
    <p class="wq-summary"><%= wq_linkify(flow.happening, item.slug) %></p>
    <p class="text-[12.5px] wq-your-part"><strong>Your part:</strong>
      <% if roll.need_you.any? %>
        <%= flow.your_part unless flow.your_part.start_with?("Nothing") %>
        <%= pluralize(roll.need_you.size, "child step") %> <%= roll.need_you.size == 1 ? "needs" : "need" %> you:
        <% roll.need_you.each do |k| %>
          <%= link_to "##{k.n} #{progress.flow(k).label}", work_queue_item_detail_path(k.key), class: "wq-ref", title: k.title, data: { turbo_frame: "wq_detail" } %>
        <% end %>
      <% else %>
        <%= flow.your_part %>
      <% end %>
    </p>
    <% kids = context.children %>
    <% if kids.any? %>
      <div class="wq-kid-steps">
        <span class="wq-eyebrow">Earlier child items (read-only)</span>
        <ul class="wq-related">
          <% kids.each do |k| %>
            <% kf = progress.flow(k) %>
            <% kr = progress.for(k) %>
            <li id="wq_kid_<%= k.slug %>_<%= k.n %>">
              <%= link_to work_queue_item_detail_path(k.key), class: "wq-rel wq-rel-kid", data: { turbo_frame: "wq_detail" } do %>
                <span class="wq-dot wq-t-<%= kf.tone %>" aria-hidden="true"></span>
                <span class="min-w-0 wq-rel-t">#<%= k.n %> <%= k.title %></span>
                <% if kr.percent %>
                  <%= wq_progress(kr.percent, tone: wq_progress_tone(kf, kr), label: "Child step #{k.n}") %>
                <% else %>
                  <span></span>
                <% end %>
                <span class="wq-hint wq-rel-l"><%= wq_flow_label(kf, kr) %><%= " · #{kr.done} of #{kr.total} done" if kr.parent? %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%= render "work_queue/actions", item: item, context: context, merge_on_top: merge_on_top %>
  </section>

  <div class="wq-grid2">
    <section class="wq-box" aria-labelledby="wq_rel_h">
      <span id="wq_rel_h" class="wq-eyebrow">Related tasks</span>
      <% rel = context.related %>
      <% if rel.any? %>
        <ul class="wq-related">
          <% rel.each do |kind, r| %>
            <% rf = progress.flow(r) %>
            <li>
              <%= link_to work_queue_item_detail_path(r.key), class: "wq-rel", data: { turbo_frame: "wq_detail" } do %>
                <span class="wq-dot wq-t-<%= rf.tone %>" aria-hidden="true"></span>
                <span class="min-w-0"><span class="wq-rel-kind"><%= kind %></span><br><span class="wq-rel-t"><%= r.title %></span></span>
                <span class="wq-hint"><%= rf.label %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="wq-hint">No related tasks.</p>
      <% end %>
    </section>
    <section class="wq-box" aria-labelledby="wq_hist_h">
      <span id="wq_hist_h" class="wq-eyebrow">History</span>
      <% if item.log.any? %>
        <ol class="wq-hist">
          <% item.log.last(20).each do |l| %>
            <li><span class="wq-time wq-mono"><%= Time.zone.at(l["at"].to_i / 1000).strftime("%b %-d %H:%M") %></span><span><%= wq_linkify(l["text"], item.slug) %></span></li>
          <% end %>
        </ol>
      <% else %>
        <p class="wq-hint">Nothing yet.</p>
      <% end %>
    </section>
  </div>

  <details class="wq-box wq-more">
    <summary class="wq-eyebrow">Run controls, branch and model</summary>
    <%= render "work_queue/git", item: item, context: context, full: true %>
    <%= render "work_queue/run_panel", item: item, context: context unless item.errand? %>
  </details>
</header>
