<% context ||= WorkQueue::ItemContext.new(item, store: WorkQueue::Store.new) %>
<header id="wq_log_header" class="wq-log-h">
  <div class="flex items-center gap-2 min-w-0">
    <%= link_to "##{item.n}", work_queue_path(item: item.key), class: "wq-n", data: { turbo_frame: "wq_detail" } %>
    <h2 class="wq-log-title"><%= item.title %></h2>
    <%= render "work_queue/badge", item: item %>
    <span class="wq-hint"><%= WorkQueue::Store.label(item.slug) %></span>
    <span class="ml-auto"><%= wq_copy_menu(item, context) %></span>
  </div>
  <%= render "work_queue/git", item: item, context: context, full: true %>
  <div class="wq-links">
    <% if item.pr.present? %><a class="wq-link" href="<%= item.pr %>" target="_blank" rel="noopener">PR <%= item.pr_number ? "##{item.pr_number}" : "" %></a><% end %>
    <% siblings = WorkQueue::Store.new.items_for(item.slug) %>
    <% if (parent = siblings.find { |i| i.n == item.parent }) %>
      <span class="wq-hint">parent</span> <%= link_to "##{parent.n} #{parent.title.truncate(40)}", work_queue_path(item: parent.key), class: "wq-link", data: { turbo_frame: "wq_detail" } %>
    <% end %>
    <% WorkQueue::RunState.related(item.key).filter_map { |k| WorkQueue::Store.new.find(k) }.each do |rel| %>
      <span class="wq-hint">related</span> <%= link_to "##{rel.n} #{rel.title.truncate(40)}", work_queue_path(item: rel.key), class: "wq-link", data: { turbo_frame: "wq_detail" } %>
    <% end %>
    <% siblings.select { |i| i.parent == item.n }.each do |child| %>
      <span class="wq-hint">follow-up</span> <%= link_to "##{child.n} #{child.title.truncate(40)}", work_queue_path(item: child.key), class: "wq-link", data: { turbo_frame: "wq_detail" } %>
    <% end %>
  </div>
  <%= render "work_queue/run_panel", item: item, context: context %>
  <% if item.summary.present? %><p class="wq-summary"><%= wq_linkify(item.summary, item.slug) %></p><% end %>
  <div class="flex flex-wrap items-center gap-2 mt-2">
    <% if item.pending? %>
      <%= button_to "Run now", work_queue_item_run_path(item.key), class: "wq-btn wq-btn-primary", form: { data: { turbo_stream: true } } %>
    <% end %>
    <%= render "work_queue/questions", item: item %>
    <% if context.chain_merge? %>
      <%= render "work_queue/merge", item: item, url: work_queue_item_merge_chain_path(item.key), context: context,
                 label: "Merge both (#{context.chain.map { |i| "##{i.n}" }.join(' → ')})" %>
    <% elsif context.card_merge? %>
      <%= render "work_queue/merge", item: item, url: work_queue_item_merge_pr_path(item.key), label: "Merge PR", context: context %>
    <% end %>
  </div>
</header>
