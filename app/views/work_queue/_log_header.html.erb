<%# Top of the detail panel. Replaced live via the item stream (target wq_log_header). %>
<% context ||= WorkQueue::ItemContext.new(item, store: WorkQueue::Store.new) %>
<% flow = context.flow %>
<header id="wq_log_header" class="wq-log-h wq-flow">
  <nav class="wq-crumbs" aria-label="Breadcrumb">
    <span><%= WorkQueue::Store.label(item.slug) %></span>
    <% context.ancestors.each do |a| %>
      <span aria-hidden="true">›</span>
      <%= link_to a.title.truncate(40), work_queue_item_detail_path(a.key), class: "wq-crumb-link", data: { turbo_frame: "wq_detail" } %>
    <% end %>
    <span aria-hidden="true">›</span><span aria-current="page">this task</span>
  </nav>

  <div class="wq-flow-head">
    <div class="flex flex-wrap items-center gap-2">
      <span class="wq-pill wq-pill-<%= flow.tone %>"><%= flow.label %></span>
      <span class="wq-hint wq-mono"><%= flow.ref %></span>
      <% if item.session.present? %><%= render "work_queue/listener", item: item %><% end %>
      <span class="ml-auto"><%= wq_copy_menu(item, context) %></span>
    </div>
    <h2 class="wq-flow-title"><%= item.title %></h2>
  </div>

  <%= render "work_queue/question_box", item: item %>

  <section class="wq-box wq-now" aria-label="What's happening">
    <span class="wq-eyebrow">What's happening</span>
    <% now = WorkQueue::Flow::PHASES[flow.phase] %>
    <ol class="wq-path" aria-label="<%= now ? "Now: #{now}" : 'All phases done' %>">
      <% flow.phases.each_with_index do |(name, state), i| %>
        <%= tag.li class: ["wq-step", ("wq-step-#{state}" if state)], aria: { current: ("step" if i == flow.phase) } do %><i aria-hidden="true"></i><%= name %><% end %>
      <% end %>
    </ol>
    <% if flow.failed_checks.any? %>
      <p class="text-[12.5px]"><strong>Failed checks:</strong> <%= flow.failed_checks.join(", ") %></p>
    <% end %>
    <% if flow.delivery_note %>
      <p class="text-[12.5px]"><%= flow.delivery_note %></p>
    <% end %>
    <p class="wq-summary"><%= wq_linkify(flow.happening, item.slug) %></p>
    <p class="text-[12.5px]"><strong>Your part:</strong> <%= flow.your_part %></p>
    <% kids = context.children %>
    <% if kids.any? %>
      <div class="wq-kid-steps">
        <span class="wq-eyebrow">Child steps (run in parallel, ship in this task's PR)</span>
        <ul class="wq-related">
          <% kids.each do |k| %>
            <% kf = WorkQueue::Flow.new(k) %>
            <li id="wq_kid_<%= k.slug %>_<%= k.n %>">
              <%= link_to work_queue_item_detail_path(k.key), class: "wq-rel", data: { turbo_frame: "wq_detail" } do %>
                <span class="wq-dot wq-t-<%= kf.tone %>" aria-hidden="true"></span>
                <span class="min-w-0 wq-rel-t">#<%= k.n %> <%= k.title %></span>
                <span class="wq-hint"><%= kf.label %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%= render "work_queue/actions", item: item, context: context %>
  </section>

  <div class="wq-grid2">
    <section class="wq-box" aria-labelledby="wq_rel_h">
      <span id="wq_rel_h" class="wq-eyebrow">Related tasks</span>
      <% rel = context.related %>
      <% if rel.any? %>
        <ul class="wq-related">
          <% rel.each do |kind, r| %>
            <% rf = WorkQueue::Flow.new(r) %>
            <li>
              <%= link_to work_queue_item_detail_path(r.key), class: "wq-rel", data: { turbo_frame: "wq_detail" } do %>
                <span class="wq-dot wq-t-<%= rf.tone %>" aria-hidden="true"></span>
                <span class="min-w-0"><span class="wq-rel-kind"><%= kind %></span><br><span class="wq-rel-t"><%= r.title %></span></span>
                <span class="wq-hint"><%= rf.label %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="wq-hint">No related tasks.</p>
      <% end %>
    </section>
    <section class="wq-box" aria-labelledby="wq_hist_h">
      <span id="wq_hist_h" class="wq-eyebrow">History</span>
      <% if item.log.any? %>
        <ol class="wq-hist">
          <% item.log.last(20).each do |l| %>
            <li><span class="wq-time wq-mono"><%= Time.zone.at(l["at"].to_i / 1000).strftime("%b %-d %H:%M") %></span><span><%= wq_linkify(l["text"], item.slug) %></span></li>
          <% end %>
        </ol>
      <% else %>
        <p class="wq-hint">Nothing yet.</p>
      <% end %>
    </section>
  </div>

  <details class="wq-box wq-more">
    <summary class="wq-eyebrow">Run controls, branch and model</summary>
    <%= render "work_queue/git", item: item, context: context, full: true %>
    <%= render "work_queue/run_panel", item: item, context: context %>
  </details>
</header>
