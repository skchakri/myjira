<% active = local_assigns[:selected] == item.key %>
<article id="<%= item.dom_id %>" class="wq-card <%= 'wq-card-active' if active %>"
         data-work-queue-target="card" data-key="<%= item.key %>" data-slug="<%= item.slug %>" data-n="<%= item.n %>"
         data-status="<%= item.display_status %>" data-title="<%= item.title %>"
         <% if item.open? %>draggable="true" data-action="dragstart->work-queue#cardDragStart dragover->work-queue#cardDragOver dragleave->work-queue#cardDragLeave drop->work-queue#cardDrop dragend->work-queue#cardDragEnd"<% end %>>
  <div class="flex items-start gap-2">
    <% if item.open? %>
      <input type="checkbox" class="wq-check" aria-label="Select #<%= item.n %>" data-action="work-queue#select" value="<%= item.key %>">
    <% end %>
    <%= link_to work_queue_item_detail_path(item.key), class: "wq-card-link", data: { turbo_frame: "wq_detail", work_queue_target: "link", action: "click->work-queue#open" } do %>
      <span class="wq-n">#<%= item.n %></span>
      <span class="wq-title"><%= item.title %></span>
    <% end %>
    <% if item.pending? %>
      <%= button_to work_queue_item_run_path(item.key), class: "wq-icon-btn", title: "Run now (r)", "aria-label": "Run ##{item.n} now",
                    form: { data: { turbo_stream: true }, class: "wq-run-form" } do %>
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
      <% end %>
    <% end %>
    <%= render "work_queue/badge", item: item %>
    <%= wq_copy_menu(item, context) %>
  </div>
  <% if item.open? %>
    <%= render "work_queue/git", item: item, context: context %>
    <% if context&.card_merge? || item.pr.present? || item.open_questions.any? %>
      <div class="wq-card-actions">
        <%= render "work_queue/questions", item: item %>
        <% if context&.card_merge? %>
          <%= render "work_queue/merge", item: item, url: work_queue_item_merge_pr_path(item.key), label: "Merge PR", context: context %>
        <% end %>
        <% if item.pr.present? %>
          <a class="wq-link" href="<%= item.pr %>" target="_blank" rel="noopener">PR <%= item.pr_number ? "##{item.pr_number}" : "" %></a>
        <% end %>
      </div>
    <% end %>
  <% end %>
</article>
