<% content_for :title, "Edit #{@document.title} · #{@project.name}" %>
<% content_for :page_bg, project_page_bg(@project) %>
<%= render "breadcrumb", here: @document.slug %>
<h1 class="text-2xl font-semibold tracking-tight text-[color:var(--color-ink)] mt-1 mb-5">Edit document <span class="font-mono text-sm text-[color:var(--color-ink-faint)]">v<%= @document.version %></span></h1>
<%= render "form", document: @document %>
