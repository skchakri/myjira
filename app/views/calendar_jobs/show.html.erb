<% source   = CalendarOccurrences.source_of(@item)
   schedule = @item.is_a?(AgentSchedule)
   project  = @item.project
   command  = schedule ? @item.prompt : @item.command %>
<%= turbo_frame_tag "calendar_drawer" do %>
  <div data-controller="modal" data-action="click->modal#backdrop"
       class="fixed inset-0 z-50 flex justify-end" style="background: rgba(26,24,20,0.45)">
    <div role="dialog" aria-modal="true" aria-labelledby="cal-drawer-heading"
         class="paper w-full max-w-md h-full overflow-y-auto rounded-none" style="box-shadow: -24px 0 60px -20px rgba(26,24,20,0.5)">
      <header class="flex items-start justify-between gap-3 px-5 py-4 hair-b">
        <div class="min-w-0">
          <div class="flex items-center gap-1.5 eyebrow cal-src-<%= source %>">
            <%= calendar_source_glyph(source) %><%= CalendarJob::SOURCES.dig(source, :label) %>
          </div>
          <h2 id="cal-drawer-heading" class="text-base font-medium mt-1"><%= CalendarOccurrences.title_of(@item) %></h2>
        </div>
        <button data-action="modal#close" class="grid place-items-center h-10 w-10 shrink-0 text-[color:var(--color-ink-faint)] hover:text-[color:var(--color-ink)]" aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </header>

      <div class="px-5 py-4 space-y-5 text-sm">
        <dl class="grid grid-cols-[96px_1fr] gap-x-3 gap-y-2">
          <dt class="eyebrow pt-0.5">Schedule</dt>
          <dd>
            <% if @item.cron.present? %><code class="font-mono text-[12px]"><%= @item.cron %></code><% end %>
            <% label = @item.try(:schedule_label) %>
            <% if label.present? %><div class="text-[color:var(--color-ink-soft)]"><%= label %></div><% end %>
            <% if @item.cron.blank? && label.blank? %><span class="text-[color:var(--color-ink-faint)]">—</span><% end %>
          </dd>
          <dt class="eyebrow pt-0.5">Status</dt>
          <dd>
            <% if !schedule && @item.suggested? %>
              <span class="inline-flex items-center gap-1.5"><span class="dot dot-idle" aria-hidden="true"></span><%= @item.promoted? ? "Scheduled in myjira" : "Not scheduled — suggestion only" %></span>
            <% elsif @item.respond_to?(:enabled?) && !@item.enabled? %>
              <span class="inline-flex items-center gap-1.5"><span class="dot dot-idle" aria-hidden="true"></span>Paused</span>
            <% else %>
              <span class="inline-flex items-center gap-1.5"><span class="dot dot-pass" aria-hidden="true"></span>Active</span>
            <% end %>
          </dd>
          <% if project %>
            <dt class="eyebrow pt-0.5">Project</dt>
            <dd><%= link_to project.name, board_path(project), class: "underline hover:text-[color:var(--color-amber-ink)]", data: { turbo_frame: "_top" } %></dd>
          <% end %>
          <% if @item.try(:last_run_at) %>
            <dt class="eyebrow pt-0.5">Last run</dt>
            <dd class="tabular"><%= format_time(@item.last_run_at.in_time_zone(@zone)) %></dd>
          <% end %>
          <% if @next_runs.any? %>
            <dt class="eyebrow pt-0.5">Next runs</dt>
            <dd class="tabular space-y-0.5">
              <% @next_runs.each do |t| %><div><%= t.in_time_zone(@zone).strftime("%a %b %-d · %H:%M") %></div><% end %>
            </dd>
          <% elsif @item.try(:next_run_at) %>
            <dt class="eyebrow pt-0.5">Next run</dt>
            <dd class="tabular"><%= format_time(@item.next_run_at.in_time_zone(@zone)) %></dd>
          <% end %>
        </dl>

        <% if command.present? %>
          <div>
            <h3 class="eyebrow mb-1.5"><%= schedule || @item.suggested? ? "Prompt" : "Command" %></h3>
            <pre class="paper-sunk p-3 text-[12px] font-mono whitespace-pre-wrap break-words"><%= command %></pre>
          </div>
        <% end %>

        <% if !schedule && @item.evidence.present? %>
          <div>
            <h3 class="eyebrow mb-1.5">Why this was suggested</h3>
            <p class="text-[color:var(--color-ink-soft)] whitespace-pre-line"><%= @item.evidence %></p>
          </div>
        <% end %>

        <% if schedule %>
          <div class="flex flex-wrap gap-2 hair-t pt-4">
            <%= button_to (@item.enabled? ? "Pause" : "Resume"), toggle_agent_schedule_path(@item),
                  form: { data: { turbo_frame: "_top" } },
                  class: "paper h-10 px-4 text-sm hover:text-[color:var(--color-amber-ink)] cursor-pointer" %>
            <%= link_to "Open in project", project_conversations_path(project), data: { turbo_frame: "_top" },
                  class: "paper h-10 px-4 grid place-items-center text-sm hover:text-[color:var(--color-amber-ink)]" %>
          </div>
        <% elsif @item.suggested? %>
          <div class="hair-t pt-4">
            <% if @item.promoted? %>
              <p class="text-[color:var(--color-ink-soft)]">
                Scheduled in <%= link_to @item.agent_schedule.project.name, project_conversations_path(@item.agent_schedule.project), class: "underline", data: { turbo_frame: "_top" } %>
                — <%= @item.agent_schedule.enabled? ? "running on its cron" : "paused until you turn it on" %>.
              </p>
            <% else %>
              <%= form_with url: promote_calendar_job_path(@item), method: :post, data: { turbo_frame: "_top" }, class: "space-y-3" do |f| %>
                <div>
                  <label for="cal-promote-project" class="eyebrow block mb-1.5">Run it in</label>
                  <select id="cal-promote-project" name="project_id" required
                          class="w-full h-10 px-2 text-sm bg-[color:var(--color-paper-raised)] hair-all rounded-md text-[color:var(--color-ink)]">
                    <% @projects.each do |p| %>
                      <option value="<%= p.id %>" <%= "selected" if p.id == @item.project_id %>><%= p.name %></option>
                    <% end %>
                  </select>
                  <p class="text-[11.5px] text-[color:var(--color-ink-faint)] mt-1.5">Creates a myjira schedule with this prompt and cron, <strong>paused</strong> — nothing runs until you resume it.</p>
                </div>
                <div class="flex flex-wrap gap-2">
                  <button type="submit" class="h-10 px-4 rounded-md text-sm font-medium cursor-pointer text-[color:var(--color-paper-raised)] bg-[color:var(--color-amber-ink)] hover:bg-[color:var(--color-amber-ink-hover)] transition-colors">
                    Schedule in myjira
                  </button>
                </div>
              <% end %>
              <%= button_to "Dismiss suggestion", dismiss_calendar_job_path(@item),
                    form: { data: { turbo_frame: "_top" }, class: "mt-2" },
                    class: "h-10 px-1 text-sm text-[color:var(--color-ink-soft)] underline hover:text-[color:var(--color-fail-ink)] cursor-pointer" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
